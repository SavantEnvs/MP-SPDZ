a = sint(7)
b = sint(5)
print_ln('add=%s', (a + b).reveal())
print_ln('mul=%s', (a * b).reveal())
print_ln('sub=%s', (b - a).reveal())
print_ln('lt=%s', (b < a).reveal())
print_ln('eq=%s', (a == b).reveal())
print_ln('fix=%s', (sfix(1.5) * sfix(2.25)).reveal())
arr = Array(5, sint)
for i, v in enumerate((9, 3, 8, 1, 5)):
    arr[i] = sint(v)
arr.sort()
print_ln('sorted=%s', arr.reveal())
s = sint(0)
@for_range(10)
def _(i):
    s.update(s + i)
print_ln('loop=%s', s.reveal())
m = sint.Matrix(2, 2)
m.assign_all(3)
print_ln('dot=%s', sint.dot_product([m[0][0], m[0][1]], [m[1][0], m[1][1]]).reveal())
print_ln('pow=%s', cint(2) ** 10)
print_ln('bit=%s', (sbit(1) & sbit(1)).reveal())
